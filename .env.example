# Domain for Caddy to serve the album on, and to request a TLS certificate for.
# Leave as :80 for a plain HTTP setup behind another proxy.
SITE_ADDRESS=albums.example.com

# The same API under a second name. Only /api is served here; everything else
# 404s, because the editor belongs on SITE_ADDRESS.
API_ADDRESS=api.albums.example.com

# Picture search: where the pictures a child finds by voice come from.
#
# Leave both of these empty and it uses Openverse, which needs no credentials
# and returns openly licensed pictures. Set both and it uses the Google Custom
# Search JSON API instead, which handles Serbian and Russian queries properly
# but returns web results with no licence attached. `npm run pictures:check`
# says which one is in use and proves the credentials work.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Set to `off` to remove picture search from the editor entirely.
PICTURE_SEARCH=
